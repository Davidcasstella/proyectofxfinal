<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.XYChart?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uptc.controlador.ControladorDashboard"
            prefWidth="900" prefHeight="600" style="-fx-background-color: #FAF9F9;">

    <!-- Menú lateral izquierdo -->
    <left>
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20;">
            <Label text="FUNDACIÓN" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
            <Label text="GARRAS Y BIGOTES" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
            <Separator />
            <VBox spacing="15" style="-fx-padding: 10 0 0 0;">
                <Label text="Explora" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                <VBox spacing="8">
                    <Button text="Principal" style="-fx-background-color: #E9E9E9; -fx-text-fill: black;" maxWidth="150" alignment="CENTER_LEFT"/>
                    <Button text="Donantes" style="-fx-background-color: transparent; -fx-text-fill: black;" maxWidth="150" alignment="CENTER_LEFT"/>
                    <Button text="Animales" style="-fx-background-color: transparent; -fx-text-fill: black;" maxWidth="150" alignment="CENTER_LEFT"/>
                    <Button text="Asignaciones" style="-fx-background-color: transparent; -fx-text-fill: black;" maxWidth="150" alignment="CENTER_LEFT"/>
                    <Button text="Reportes" style="-fx-background-color: transparent; -fx-text-fill: black;" maxWidth="150" alignment="CENTER_LEFT"/>
                    <Button text="Comentarios" style="-fx-background-color: transparent; -fx-text-fill: black;" maxWidth="150" alignment="CENTER_LEFT"/>
                </VBox>
            </VBox>
        </VBox>
    </left>

    <!-- Contenido central -->
    <center>
        <VBox spacing="15" style="-fx-padding: 15;">

            <!-- Encabezado -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Rectangle width="40" height="40" fill="black" />
                <VBox spacing="2">
                    <Label text="FUNDACIÓN GARRAS Y BIGOTES" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                    <Label text="Bienvenido User1234 (Administrador)" style="-fx-font-size: 12; -fx-text-fill: gray;"/>
                </VBox>
                <Pane HBox.hgrow="ALWAYS" />
                <HBox spacing="8" alignment="CENTER_RIGHT">
                    <Label text="👤" style="-fx-font-size: 16;"/>
                    <Label text="User1234"/>
                    <Button text="Cerrar Sesión" style="-fx-background-color: transparent; -fx-text-fill: black;"/>
                </HBox>
            </HBox>

            <!-- Pestañas -->
            <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: transparent;">
                <Tab text="Principal" />
                <Tab text="Donantes" />
                <Tab text="Animales" />
                <Tab text="Asignaciones" />
                <Tab text="Reportes" />
                <Tab text="Comentarios" />
            </TabPane>

            <!-- Estadísticas principales -->
            <HBox spacing="20" style="-fx-padding: 10;">
                <VBox spacing="4" style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 8; -fx-background-radius: 8;" prefWidth="200">
                    <Label text="Donantes" style="-fx-font-weight: bold;"/>
                    <Label fx:id="labelDonantes" text="10,353" style="-fx-font-size: 28; -fx-font-weight: bold;"/>
                    <Label text="+20% month over month" style="-fx-font-size: 11; -fx-text-fill: gray;"/>
                </VBox>
                <VBox spacing="4" style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 8; -fx-background-radius: 8;" prefWidth="200">
                    <Label text="Animales" style="-fx-font-weight: bold;"/>
                    <Label fx:id="labelAnimales" text="2,405" style="-fx-font-size: 28; -fx-font-weight: bold;"/>
                    <Label text="+33% month over month" style="-fx-font-size: 11; -fx-text-fill: gray;"/>
                </VBox>
                <VBox spacing="4" style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 8; -fx-background-radius: 8;" prefWidth="200">
                    <Label text="Donaciones" style="-fx-font-weight: bold;"/>
                    <Label fx:id="labelDonaciones" style="-fx-font-size: 28; -fx-font-weight: bold;">
                        <![CDATA[$45,678.90]]>
                    </Label>
                    <Label text="-8% month over month" style="-fx-font-size: 11; -fx-text-fill: gray;"/>
                </VBox>
            </HBox>

            <!-- Gráfico resumen mensual y actividad reciente -->
            <HBox spacing="20">
                <!-- Gráfico resumen mensual -->
<LineChart fx:id="lineChart" prefHeight="180" prefWidth="520">
    <xAxis>
        <NumberAxis />
    </xAxis>
    <yAxis>
        <NumberAxis />
    </yAxis>
</LineChart>

                <!-- Actividad reciente -->
                <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 8; -fx-background-radius: 8;" prefWidth="300" prefHeight="220">
                    <Label text="Actividad Reciente" style="-fx-font-weight: bold;"/>
                    <ListView fx:id="activityList" prefHeight="180" prefWidth="280"/>
                </VBox>
            </HBox>

            <!-- Animales por estado de salud -->
            <HBox spacing="20" style="-fx-padding: 10 0 0 0;">
                <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 8; -fx-background-radius: 8;" prefWidth="250" alignment="CENTER_LEFT" spacing="8">
                    <Label text="Bueno" />
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ProgressBar fx:id="progressBueno" progress="0.5" prefWidth="150"/>
                        <Label fx:id="labelBueno" text="50" />
                    </HBox>
                </VBox>

                <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 8; -fx-background-radius: 8;" prefWidth="250" alignment="CENTER_LEFT" spacing="8">
                    <Label text="Regular" />
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ProgressBar fx:id="progressRegular" progress="0.3" prefWidth="150"/>
                        <Label fx:id="labelRegular" text="30" />
                    </HBox>
                </VBox>

                <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 8; -fx-background-radius: 8;" prefWidth="250" alignment="CENTER_LEFT" spacing="8">
                    <Label text="Crítico" />
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ProgressBar fx:id="progressCritico" progress="0.1" prefWidth="150"/>
                        <Label fx:id="labelCritico" text="10" />
                    </HBox>
                </VBox>
            </HBox>

        </VBox>
    </center>

</BorderPane>

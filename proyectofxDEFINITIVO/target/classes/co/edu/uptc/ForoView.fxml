<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx/8.0.171" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="co.edu.uptc.controlador.ForoController">
    <VBox spacing="20" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" 
          AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">
        
        <Label text="Foro de la Fundación" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <!-- Contenedor con scroll para los comentarios -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <VBox fx:id="comentariosContainer" spacing="15">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
            </VBox>
        </ScrollPane>

        <Separator />

        <!-- Formulario para agregar nuevo comentario -->
        <VBox spacing="10">
            <Label text="Agregar Comentario:" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <TextField fx:id="autorField" promptText="Tu nombre" style="-fx-padding: 10;"/>
            <TextArea fx:id="contenidoArea" promptText="Escribe tu comentario..." 
                     prefRowCount="3" style="-fx-padding: 10;"/>
            <Button text="Publicar" onAction="#agregarComentario" 
                   style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 30; -fx-font-weight: bold;"/>
        </VBox>
    </VBox>
</AnchorPane>
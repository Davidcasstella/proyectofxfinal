<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uptc.controlador.ControladorTuPropiaContraseña"
            style="-fx-background-color: white;"
            prefWidth="900" prefHeight="360">

    <!-- Contenedor principal con fondo gris claro y bordes redondeados -->
    <VBox layoutX="30" layoutY="30" spacing="20" prefWidth="840" prefHeight="300"
          style="-fx-background-color: #f0f0f0; -fx-background-radius: 10; -fx-padding: 30;">

        <!-- Barra de botones afuera -->
        <HBox spacing="10" alignment="TOP_LEFT" >

            <Button text="←"
                    onAction="#handleAnterior"
                    style="-fx-font-size: 12px; -fx-padding: 4px; -fx-min-width: 30px; -fx-min-height: 30px; -fx-background-color: rgb(100, 103, 107); -fx-text-fill: white; -fx-border-radius: 15px;" />

            <Button text="→"
                    onAction="#handleSiguienteBtn"
                    style="-fx-font-size: 12px; -fx-padding: 4px; -fx-min-width: 30px; -fx-min-height: 30px; -fx-background-color: rgb(100, 103, 107); -fx-text-fill: white; -fx-border-radius: 15px;" />

            <Button text="↻"
                    onAction="#handleRecargar"
                    style="-fx-font-size: 12px; -fx-padding: 4px; -fx-min-width: 30px; -fx-min-height: 30px;" />

        </HBox>

        <!-- Contenido: texto y formulario -->
        <HBox spacing="50" prefWidth="840" prefHeight="220">

            <!-- Izquierda: texto de título y descripción -->
            <VBox spacing="10" prefWidth="400" alignment="TOP_LEFT">
                <Label text="Crea tu nueva contraseña"
                       style="-fx-font-size: 26px; -fx-font-weight: bold;" />
                <Label text="Establece una nueva contraseña segura para acceder nuevamente a tu cuenta."
                       wrapText="true" prefWidth="350" />
            </VBox>

            <!-- Derecha: formulario con etiquetas y campos -->
            <VBox spacing="25" prefWidth="350" alignment="TOP_RIGHT">

                <VBox spacing="5" prefWidth="320">
                    <Label text="Nueva contraseña"
                           style="-fx-font-size: 14px; -fx-font-weight: normal;"/>
                    <PasswordField fx:id="txtNuevaContrasena"
                                   promptText="Nueva contraseña"
                                   prefWidth="320"
                                   style="-fx-background-radius: 5; -fx-border-radius: 5;" />
                </VBox>

                <VBox spacing="5" prefWidth="320">
                    <Label text="Confirme su nueva contraseña"
                           style="-fx-font-size: 14px; -fx-font-weight: normal;"/>
                    <PasswordField fx:id="txtConfirmaContrasena"
                                   promptText="Confirme su nueva contraseña"
                                   prefWidth="320"
                                   style="-fx-background-radius: 5; -fx-border-radius: 5;" />
                </VBox>

                <Button text="Siguiente"
                        fx:id="btnSiguiente"
                        onAction="#handleSiguiente"
                        prefWidth="100"
                        style="-fx-background-radius: 15; -fx-padding: 8 20; -fx-font-size: 14px;" />

                <Label fx:id="lblMensaje" style="-fx-text-fill: red;" wrapText="true" prefWidth="320" />

            </VBox>

        </HBox>
    </VBox>

</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uptc.controlador.ChatController"
            style="-fx-background-color: white;">

    <center>
        <VBox fx:id="chatContainer" spacing="10">
            <ScrollPane fitToWidth="true" fitToHeight="true" prefHeight="400.0" prefWidth="600.0">
                <content>
                    <VBox fx:id="messagesBox" spacing="8">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <TextField fx:id="messageField" HBox.hgrow="ALWAYS" promptText="Escribe tu mensaje..." />
            <Button text="Enviar" onAction="#enviarMensaje" />
        </HBox>
    </bottom>

    <right>
        <VBox spacing="10" alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <ImageView fitWidth="100" fitHeight="100" />
            <Label fx:id="nombreUsuarioLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
            <Label fx:id="estadoLabel" text="Activo recientemente" />
            <Button text="Ver perfil" onAction="#verPerfil" />
            <Button text="🏠 Menú principal" onAction="#irMenuPrincipal" />
        </VBox>
    </right>
</BorderPane>
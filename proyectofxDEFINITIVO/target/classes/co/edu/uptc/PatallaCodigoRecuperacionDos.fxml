<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uptc.controlador.ControladorReceperacionDos" style="-fx-background-color: #f4f4f4; -fx-padding: 30px;">

    <!-- Pantalla principal (tarjeta) -->
    <VBox fx:id="mainCard" spacing="20" style="-fx-background-color: #e9e9e9; -fx-background-radius: 15px; -fx-padding: 40px;" alignment="CENTER" 
        AnchorPane.topAnchor="50.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" prefHeight="220" prefWidth="900">

        <HBox spacing="30" alignment="CENTER_LEFT" prefWidth="900">

            <!-- Logo -->
            <VBox alignment="CENTER" style="-fx-background-color: #000000; -fx-min-width: 80px; -fx-min-height: 80px; -fx-background-radius: 8px;">
                <Label text="Logo" style="-fx-text-fill: white; -fx-font-weight: bold;" />
            </VBox>

            <!-- Texto título y subtítulo -->
            <VBox spacing="8" alignment="CENTER_LEFT" prefWidth="350">
                <Label text="¿Cómo te llamas?" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: black;" wrapText="true" />
                <Label text="Ingresa el nombre completo de tu cuenta con el que te registraste" style="-fx-font-size: 14px; -fx-text-fill: #666666;" wrapText="true" />
            </VBox>

            <!-- Campos y botón -->
            <VBox spacing="15" alignment="TOP_LEFT">

                <TextField fx:id="fullNameField" promptText="Nombre completo" style="-fx-pref-width: 320px; -fx-padding: 10px; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #cccccc; -fx-font-size: 14px;" />
                <TextField fx:id="emailField" promptText="Correo electrónico (registrado)" style="-fx-pref-width: 320px; -fx-padding: 10px; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #cccccc; -fx-font-size: 14px;" />

                <Button fx:id="nextButton" text="Siguiente" style="-fx-background-color: #bfbfbf; -fx-text-fill: black; -fx-padding: 8px 20px; -fx-background-radius: 15px; -fx-font-size: 14px;" maxWidth="320" />

            </VBox>

        </HBox>

        <!-- Línea separadora -->
        <Label style="-fx-background-color: #dcdcdc; -fx-pref-height: 1px; -fx-pref-width: 900px;" />
         <!-- Botón para ir a la pantalla siguiente pantalla -->

        <Button text="←" onAction="#Antesss" 
        style="-fx-font-size: 12px; -fx-padding: 4px; -fx-min-width: 30px; -fx-min-height: 30px; -fx-background-color: rgb(100, 103, 107); -fx-text-fill: white; -fx-border-radius: 15px;" />
        <Button text="→" onAction="#Siguienteee" 
        style="-fx-font-size: 12px; -fx-padding: 4px; -fx-min-width: 30px; -fx-min-height: 30px; -fx-background-color: rgb(100, 103, 107); -fx-text-fill: white; -fx-border-radius: 15px;" />
        <Button text="↻" onAction="#reloadPageee" 
        style="-fx-font-size: 12px; -fx-padding: 4px; -fx-min-width: 30px; -fx-min-height: 30px;" />
    </VBox>

    <!-- Panel modal oculto al inicio -->
    <AnchorPane fx:id="modalPane" style="-fx-background-color: rgba(0,0,0,0.4);" visible="false" managed="false"
        AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <VBox spacing="10" alignment="TOP_LEFT" style="-fx-background-color: white; -fx-padding: 30px; -fx-background-radius: 10px;"
              layoutX="250" layoutY="220" prefWidth="400" prefHeight="200">

            <HBox alignment="TOP_RIGHT" prefWidth="400">
                <Button fx:id="closeModalButton" text="X" style="-fx-background-color: transparent; -fx-font-size: 14px;" />
            </HBox>

            <Label text="Obtener un código de verificación" style="-fx-font-size: 20px; -fx-font-weight: bold;" wrapText="true" />
            <Label text="Para proteger tu cuenta, queremos confirmar que realmente eres tú quien está intentando acceder."
                   style="-fx-font-size: 14px; -fx-text-fill: gray;" wrapText="true" />

            <Button fx:id="modalNextButton" text="Siguiente" style="-fx-background-color: #bfbfbf; -fx-text-fill: black; -fx-padding: 8px 20px; -fx-background-radius: 15px; -fx-font-size: 14px;" maxWidth="100" alignment="CENTER" />
       
        </VBox>
    </AnchorPane>

</AnchorPane>

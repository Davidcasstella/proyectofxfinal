<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uptc.controlador.ControladorLogin" style="-fx-background-color: #f4f4f4; -fx-padding: 20px;">
    
    <!-- Título -->
    <Label text="FUNDACIÓN GARRAS Y BIGOTES" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #333333; -fx-padding: 10px;" layoutX="650" layoutY="0"/>

    <!-- Imagen lado izquierdo -->
    <AnchorPane layoutX="50" layoutY="80">
        <ImageView fx:id="imageView" fitWidth="520" fitHeight="520" style="-fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.1), 10, 0, 0, 5);" />
    </AnchorPane>

    <!-- Contenedor general del formulario -->
    <AnchorPane layoutX="760" layoutY="80" prefWidth="380" prefHeight="550">
        <VBox spacing="15" alignment="TOP_CENTER" style="-fx-background-color: white; -fx-border-radius: 15px; -fx-background-radius: 15px; -fx-padding: 40px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10,0,0,5);" prefWidth="350" prefHeight="530">

            <!-- Pestañas simuladas -->
            <HBox spacing="100" alignment="CENTER_LEFT" prefWidth="300" style="-fx-padding: 0 0 25 0;">
                <Label fx:id="tabLogin" text="Iniciar Sesión" style="-fx-text-fill: #0066cc; -fx-font-size: 16px; -fx-cursor: hand; -fx-font-weight: bold;" onMouseClicked="#mostrarLogin"/>
                <Label fx:id="tabRegister" text="Registrarse" style="-fx-text-fill: #999999; -fx-font-size: 16px; -fx-cursor: hand;" onMouseClicked="#mostrarRegistro"/>
            </HBox>

            <!-- Formulario Login -->
            <VBox fx:id="loginForm" spacing="15" alignment="TOP_LEFT" prefWidth="320" prefHeight="440" visible="true" managed="true">

                <!-- Correo -->
                <VBox spacing="6" alignment="TOP_LEFT" prefWidth="320">
                    <Label text="Correo electrónico" style="-fx-font-size: 14px; -fx-text-fill: #555555;" />
                    <TextField fx:id="emailField" promptText="Correo electrónico" style="-fx-pref-width: 320px; -fx-background-radius: 20px; -fx-border-radius: 20px; -fx-border-color: #cccccc; -fx-padding: 10px; -fx-font-size: 14px;" onKeyReleased="#validateEmail"/>
                    <Label fx:id="emailErrorLabel" style="-fx-font-size: 12px; -fx-text-fill: red;" />
                </VBox>

                <!-- Contraseña -->
                <VBox spacing="6" alignment="TOP_LEFT" prefWidth="320">
                    <Label text="Contraseña" style="-fx-font-size: 14px; -fx-text-fill: #555555;" />
                    <PasswordField fx:id="passwordField" promptText="Contraseña" style="-fx-pref-width: 320px; -fx-background-radius: 20px; -fx-border-radius: 20px; -fx-border-color: #cccccc; -fx-padding: 10px; -fx-font-size: 14px;" onKeyReleased="#validatePassword"/>
                    <Label fx:id="passwordErrorLabel" style="-fx-font-size: 12px; -fx-text-fill: red;" />
                </VBox>

                <CheckBox fx:id="rememberMeCheckBox" text="Recordar sesión" style="-fx-font-size: 12px; -fx-text-fill: #777777;" />

                <Button fx:id="loginButton" text="Iniciar sesión" style="-fx-background-color: #000000; -fx-text-fill: white; -fx-pref-width: 320px; -fx-background-radius: 20px; -fx-padding: 12px; -fx-font-size: 16px;" onAction="#handleLogin"/>

                <Hyperlink fx:id="forgotPasswordLink" text="Olvidaste tu contraseña?" onAction="#handleForgotPassword" style="-fx-font-size: 12px; -fx-text-fill: #0066cc;" />

                <HBox alignment="CENTER_LEFT" spacing="10" prefWidth="320">
                    <Button fx:id="googleButton" text="Continuar con Google" onAction="#continuarConGoogle" style="-fx-background-color: rgb(48, 120, 221); -fx-text-fill: white; -fx-pref-width: 320px; -fx-background-radius: 20px; -fx-padding: 10px; -fx-font-size: 16px;" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-font-size: 12px; -fx-text-fill: #777777;">
                    <Label text="¿No tienes una cuenta?" />
                    <Hyperlink fx:id="goToRegisterLink" text="Regístrate" onAction="#mostrarRegistro" style="-fx-text-fill: #0066cc;" />
                </HBox>
            </VBox>

            <!-- Formulario Registro -->
            <VBox fx:id="registerForm" spacing="15" alignment="TOP_LEFT" prefWidth="320" prefHeight="520" visible="false" managed="false">

                <!-- Nombre -->
                <VBox spacing="4" alignment="TOP_LEFT" prefWidth="320">
                    <Label text="Nombre completo" style="-fx-font-size: 14px; -fx-text-fill: #555555;" />
                    <TextField fx:id="fullNameField" promptText="Ingrese su nombre completo" style="-fx-pref-width: 320px; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #ccc; -fx-padding: 8px;" />
                </VBox>

                <!-- Email registro -->
                <VBox spacing="4" alignment="TOP_LEFT" prefWidth="320">
                    <Label text="Correo electrónico" style="-fx-font-size: 14px; -fx-text-fill: #555555;" />
                    <TextField fx:id="emailRegisterField" promptText="Ingrese su correo electrónico" style="-fx-pref-width: 320px; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #ccc; -fx-padding: 8px;" />
                </VBox>

                <!-- Recuperación -->
                <VBox spacing="4" alignment="TOP_LEFT" prefWidth="320">
                    <Label text="Correo o número de recuperación" style="-fx-font-size: 14px; -fx-text-fill: #555555;" />
                    <TextField fx:id="recoveryField" promptText="Correo o número para recuperación" style="-fx-pref-width: 320px; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #ccc; -fx-padding: 8px;" />
                </VBox>

                <!-- Contraseña -->
                <VBox spacing="4" alignment="TOP_LEFT" prefWidth="320">
                    <Label text="Contraseña" style="-fx-font-size: 14px; -fx-text-fill: #555555;" />
                    <PasswordField fx:id="passwordRegisterField" promptText="Crea una contraseña" style="-fx-pref-width: 320px; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #ccc; -fx-padding: 8px;" />
                </VBox>

                <!-- Confirmar contraseña -->
                <VBox spacing="4" alignment="TOP_LEFT" prefWidth="320">
                    <Label text="Confirmar contraseña" style="-fx-font-size: 14px; -fx-text-fill: #555555;" />
                    <PasswordField fx:id="confirmPasswordField" promptText="Confirma tu contraseña" style="-fx-pref-width: 320px; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #ccc; -fx-padding: 8px;" />
                </VBox>

                <Button fx:id="registerButton" text="Registrarse" style="-fx-background-color: black; -fx-text-fill: white; -fx-pref-width: 320px; -fx-background-radius: 20px; -fx-padding: 12px; -fx-font-size: 16px;" onAction="#handleRegister" />

                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-font-size: 12px; -fx-text-fill: #777777;">
                    <Label text="¿Ya tienes una cuenta?" />
                    <Hyperlink fx:id="goToLoginLink" text="Inicia sesión" onAction="#mostrarLogin" style="-fx-text-fill: #0066cc;" />
                </HBox>

            </VBox>

        </VBox>

        <!-- Botones de navegación abajo a la izquierda -->
        <HBox spacing="10" layoutX="-730" layoutY="-70" alignment="CENTER_LEFT">
        <Button text="←" onAction="#Antes" 
        style="-fx-font-size: 12px; -fx-padding: 4px; -fx-min-width: 30px; -fx-min-height: 30px; -fx-background-color: rgb(100, 103, 107); -fx-text-fill: white; -fx-border-radius: 15px;" />
        <Button text="→" onAction="#Siguiente" 
        style="-fx-font-size: 12px; -fx-padding: 4px; -fx-min-width: 30px; -fx-min-height: 30px; -fx-background-color: rgb(100, 103, 107); -fx-text-fill: white; -fx-border-radius: 15px;" />
        <Button text="↻" onAction="#reloadPage" 
        style="-fx-font-size: 12px; -fx-padding: 4px; -fx-min-width: 30px; -fx-min-height: 30px;" />
</HBox>

    </AnchorPane>

</AnchorPane>

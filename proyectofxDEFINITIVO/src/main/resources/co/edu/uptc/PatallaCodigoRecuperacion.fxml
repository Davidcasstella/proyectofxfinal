<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uptc.controlador.ControladorReceperacion" style="-fx-background-color: #f4f4f4; -fx-padding: 30px;">

    <!-- Botones en esquina superior izquierda -->
    <HBox spacing="10" alignment="CENTER_LEFT"
          AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0">
        <Button text="←" onAction="#Antess"
                style="-fx-font-size: 12px; -fx-padding: 4px; -fx-min-width: 30px; -fx-min-height: 30px; -fx-background-color: rgb(100, 103, 107); -fx-text-fill: white; -fx-border-radius: 15px;" />
        <Button text="→" onAction="#Siguientee"
                style="-fx-font-size: 12px; -fx-padding: 4px; -fx-min-width: 30px; -fx-min-height: 30px; -fx-background-color: rgb(100, 103, 107); -fx-text-fill: white; -fx-border-radius: 15px;" />
        <Button text="↻" onAction="#reloadPagee"
                style="-fx-font-size: 12px; -fx-padding: 4px; -fx-min-width: 30px; -fx-min-height: 30px;" />
    </HBox>

    <VBox fx:id="mainCard" spacing="20" style="-fx-background-color: #e9e9e9; -fx-background-radius: 15px; -fx-padding: 40px;" alignment="CENTER" prefWidth="900" prefHeight="200"
          AnchorPane.topAnchor="50.0"
          AnchorPane.bottomAnchor="50.0"
          AnchorPane.leftAnchor="50.0"
          AnchorPane.rightAnchor="50.0">

        <HBox spacing="25" alignment="CENTER_LEFT" prefWidth="900">

            <VBox alignment="CENTER" style="-fx-background-color: #000000; -fx-min-width: 80px; -fx-min-height: 80px; -fx-background-radius: 8px;">
                <Label text="Logo" style="-fx-text-fill: white; -fx-font-weight: bold;" />
            </VBox>

            <VBox spacing="6" alignment="CENTER_LEFT" prefWidth="400">
                <Label text="FUNDACIÓN GARRAS Y BIGOTES" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: black;" wrapText="true" />
                <Label text="Ingresa tu número de teléfono o correo de recuperación" style="-fx-font-size: 14px; -fx-text-fill: #666666;" wrapText="true" />
            </VBox>

            <TextField fx:id="recoveryField" promptText="Correo o número de recuperación" style="-fx-pref-width: 320px; -fx-padding: 10px; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-border-color: #cccccc; -fx-font-size: 14px;" />

            <Button fx:id="nextButton" text="Siguiente" style="-fx-background-color: #bfbfbf; -fx-text-fill: black; -fx-padding: 8px 20px; -fx-background-radius: 15px; -fx-font-size: 14px;" />
        </HBox>

        <Label style="-fx-background-color: #dcdcdc; -fx-pref-height: 1px; -fx-pref-width: 900px;" />
        <!-- Botón para ir a la pantalla siguiente pantalla -->

    </VBox>

</AnchorPane>

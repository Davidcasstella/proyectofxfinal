<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uptc.controlador.ControladorReceperacionTres"
            style="-fx-background-color: #f4f4f4; -fx-padding: 30px;"
            prefWidth="900" prefHeight="280">

    <StackPane prefWidth="900" prefHeight="280">

        <!-- Contenido principal -->
        <VBox spacing="25"
              style="-fx-background-color: #e9e9e9; -fx-background-radius: 15px; -fx-padding: 40px;"
              alignment="CENTER"
              prefHeight="280"
              prefWidth="800">

            <HBox spacing="25"
                  alignment="CENTER"
                  style="-fx-padding: 0 0 15 0;">

                <!-- Logo -->
                <VBox alignment="CENTER"
                      style="-fx-background-color: #000000; -fx-min-width: 80px; -fx-min-height: 80px; -fx-background-radius: 8px;">
                    <Label text="Logo"
                           style="-fx-text-fill: white; -fx-font-weight: bold;" />
                </VBox>

                <!-- Texto titulo y subtítulo -->
                <VBox spacing="6"
                      alignment="CENTER_LEFT"
                      prefWidth="600">
                    <Label text="Por favor digite el código"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: black;"
                           wrapText="true" />
                    <Label text="Por favor, revise la bandeja de entrada de su correo de recuperación en Gmail o los mensajes SMS en su número de teléfono registrado."
                           style="-fx-font-size: 14px; -fx-text-fill: #666666;"
                           wrapText="true" />
                </VBox>

            </HBox>

            <!-- Campos para código -->
            <HBox spacing="20" alignment="CENTER">
                <TextField fx:id="codeField1"
                           maxWidth="70"
                           maxHeight="80"
                           style="-fx-font-size: 36px; -fx-alignment: center; -fx-padding: 10 12 10 12;" />
                <TextField fx:id="codeField2"
                           maxWidth="70"
                           maxHeight="80"
                           style="-fx-font-size: 36px; -fx-alignment: center; -fx-padding: 10 12 10 12;" />
                <TextField fx:id="codeField3"
                           maxWidth="70"
                           maxHeight="80"
                           style="-fx-font-size: 36px; -fx-alignment: center; -fx-padding: 10 12 10 12;" />
                <TextField fx:id="codeField4"
                           maxWidth="70"
                           maxHeight="80"
                           style="-fx-font-size: 36px; -fx-alignment: center; -fx-padding: 10 12 10 12;" />
                <TextField fx:id="codeField5"
                           maxWidth="70"
                           maxHeight="80"
                           style="-fx-font-size: 36px; -fx-alignment: center; -fx-padding: 10 12 10 12;" />
                <TextField fx:id="codeField6"
                           maxWidth="70"
                           maxHeight="80"
                           style="-fx-font-size: 36px; -fx-alignment: center; -fx-padding: 10 12 10 12;" />
            </HBox>

            <!-- Botón siguiente -->
            <Button fx:id="nextButton"
                    text="Siguiente"
                    style="-fx-background-color: #bfbfbf; -fx-text-fill: black; -fx-padding: 8px 25px; -fx-background-radius: 15px; -fx-font-size: 14px;" />

            <!-- Línea separadora -->
            <Label style="-fx-background-color: #dcdcdc; -fx-pref-height: 1px; -fx-pref-width: 800px;" />

        </VBox>

        <!-- Modal emergente, inicialmente invisible y cubre toda la pantalla -->
        <AnchorPane fx:id="modalPane"
                    visible="false"
                    managed="false"
                    style="-fx-background-color: rgba(0,0,0,0.3);"
                    AnchorPane.topAnchor="0"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0">

            <VBox style="-fx-background-color: white; -fx-background-radius: 10px; -fx-padding: 30px; -fx-spacing: 10px; -fx-max-width: 450px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 5);"
                  alignment="CENTER">

                <HBox alignment="TOP_RIGHT" prefWidth="400">
                    <Label text="X"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;"
                           fx:id="closeModalLabel" />
                </HBox>

                <Label text="¡El código de verificación ha sido autenticado!"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: black;"
                       wrapText="true" />

                <Label text="Serás redirigido para actualizar tu contraseña..."
                       style="-fx-font-size: 14px; -fx-text-fill: #666666;"
                       wrapText="true" />

                <Button text="Siguiente"
                        style="-fx-background-color: #bfbfbf; -fx-text-fill: black; -fx-padding: 8px 25px; -fx-background-radius: 15px; -fx-font-size: 14px;"
                        fx:id="modalNextButton" />

                <Label style="-fx-background-color: #dcdcdc; -fx-pref-height: 1px; -fx-pref-width: 400px;" />

            </VBox>

        </AnchorPane>

    </StackPane>

</AnchorPane>
